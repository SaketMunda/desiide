{
  "name": "desiide-ai",
  "displayName": "Desiide",
  "description": "Bring-your-own-model AI coding with visible routing and risk decisions (Jev).",
  "icon": "media/icon.png",
  "version": "0.0.1",
  "private": true,
  "publisher": "desiide-dev",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/SaketMunda/desiide.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:desiide.panel",
    "onView:desiide.decisions",
    "onCommand:desiide.focus",
    "onCommand:desiide.showLog",
    "onCommand:desiide.dev.showcase"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "desiide",
          "title": "Desiide",
          "icon": "media/desiide.svg"
        }
      ]
    },
    "views": {
      "desiide": [
        {
          "type": "webview",
          "id": "desiide.panel",
          "name": "Desiide"
        },
        {
          "type": "webview",
          "id": "desiide.decisions",
          "name": "Decisions"
        }
      ]
    },
    "commands": [
      {
        "command": "desiide.focus",
        "title": "Focus Desiide",
        "category": "Desiide"
      },
      {
        "command": "desiide.showLog",
        "title": "Show Log",
        "category": "Desiide"
      },
      {
        "command": "desiide.dev.showcase",
        "title": "Toggle UI Kit Showcase (dev)",
        "category": "Desiide"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "desiide.dev.showcase",
          "when": "desiide.devMode"
        }
      ]
    },
    "themes": [
      {
        "id": "Desiide Dark",
        "label": "Desiide Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/desiide-dark-color-theme.json"
      },
      {
        "id": "Desiide Light",
        "label": "Desiide Light",
        "uiTheme": "vs",
        "path": "./themes/desiide-light-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:webview": "vite build",
    "typecheck": "tsc -b tsconfig.json tsconfig.webview.json",
    "test": "vitest run",
    "test:integration": "node scripts/build.mjs && node test/integration/run.mjs",
    "screenshots": "node scripts/build.mjs && node scripts/screenshots.mjs",
    "package": "node scripts/build.mjs --production && vsce package --no-dependencies --skip-license --out desiide-ai.vsix"
  },
  "dependencies": {
    "@vscode/codicons": "0.0.46-24",
    "preact": "^10.29.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "playwright-core": "1.63.0",
    "preact-render-to-string": "^6.7.0",
    "vite": "^8.3.1"
  }
}
