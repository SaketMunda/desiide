    "sideBarSectionHeader.border": "#2A313A",
    "list.activeSelectionBackground": "#2BB3A333",
    "list.activeSelectionForeground": "#E4E8EC",
    "list.inactiveSelectionBackground": "#2A313A",
    "list.hoverBackground": "#232932",
    "list.focusOutline": "#2BB3A3",
    "list.highlightForeground": "#4FD1C1",
    "list.warningForeground": "#E5C454",
    "list.errorForeground": "#F47C6B",
    "tree.indentGuidesStroke": "#343C46",
    "scrollbarSlider.background": "#8A939D33",
    "scrollbarSlider.hoverBackground": "#8A939D55",
    "scrollbarSlider.activeBackground": "#8A939D77",

    "editor.background": "#15191E",
    "editor.foreground": "#E4E8EC",
    "editorLineNumber.foreground": "#4A535D",
    "editorLineNumber.activeForeground": "#C9D0D7",
    "editorCursor.foreground": "#2BB3A3",
    "editor.selectionBackground": "#2BB3A340",
    "editor.inactiveSelectionBackground": "#2BB3A322",
    "editor.selectionHighlightBackground": "#2BB3A322",
    "editor.wordHighlightBackground": "#8A939D26",
    "editor.wordHighlightStrongBackground": "#2BB3A333",
    "editor.findMatchBackground": "#F2A33A55",
    "editor.findMatchHighlightBackground": "#F2A33A26",
    "editor.lineHighlightBackground": "#1B2027",
    "editor.lineHighlightBorder": "#00000000",
    "editorIndentGuide.background1": "#262C34",
    "editorIndentGuide.activeBackground1": "#3E4751",
    "editorWhitespace.foreground": "#343C46",
    "editorBracketMatch.background": "#2BB3A326",
    "editorBracketMatch.border": "#2BB3A3",
