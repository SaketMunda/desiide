    "editorWidget.background": "#1B2027",
    "editorWidget.border": "#2A313A",
    "editorHoverWidget.background": "#1B2027",
    "editorHoverWidget.border": "#2A313A",
    "editorSuggestWidget.background": "#1B2027",
    "editorSuggestWidget.border": "#2A313A",
    "editorSuggestWidget.selectedBackground": "#2BB3A333",
    "editorSuggestWidget.highlightForeground": "#4FD1C1",
    "diffEditor.insertedTextBackground": "#5BBF7A26",
    "diffEditor.removedTextBackground": "#F47C6B26",
    "diffEditor.insertedLineBackground": "#5BBF7A14",
    "diffEditor.removedLineBackground": "#F47C6B14",

    "editorGroup.border": "#1F252C",
    "editorGroupHeader.tabsBackground": "#111418",
    "editorGroupHeader.tabsBorder": "#1F252C",
    "tab.activeBackground": "#15191E",
    "tab.activeForeground": "#E4E8EC",
    "tab.activeBorderTop": "#2BB3A3",
    "tab.inactiveBackground": "#111418",
    "tab.inactiveForeground": "#8A939D",
    "tab.border": "#1F252C",
    "tab.hoverBackground": "#1B2027",
    "breadcrumb.foreground": "#8A939D",
    "breadcrumb.focusForeground": "#E4E8EC",

    "panel.background": "#111418",
    "panel.border": "#1F252C",
    "panelTitle.activeForeground": "#E4E8EC",
    "panelTitle.activeBorder": "#2BB3A3",
    "panelTitle.inactiveForeground": "#8A939D",
    "terminal.background": "#111418",
    "terminal.foreground": "#E4E8EC",
    "terminalCursor.foreground": "#2BB3A3",
    "terminal.ansiBlack": "#1B2027",
    "terminal.ansiRed": "#F47C6B",
    "terminal.ansiGreen": "#5BBF7A",
    "terminal.ansiYellow": "#F2A33A",
    "terminal.ansiBlue": "#5CA8E0",
    "terminal.ansiMagenta": "#D38FC4",
    "terminal.ansiCyan": "#2BB3A3",
    "terminal.ansiWhite": "#C9D0D7",
    "terminal.ansiBrightBlack": "#6B7580",
    "terminal.ansiBrightRed": "#FF9A8A",
    "terminal.ansiBrightGreen": "#86D99E",
    "terminal.ansiBrightYellow": "#FFC266",
    "terminal.ansiBrightBlue": "#8CC4EE",
    "terminal.ansiBrightMagenta": "#E6B0DA",
    "terminal.ansiBrightCyan": "#4FD1C1",
    "terminal.ansiBrightWhite": "#F4F6F8",

    "statusBar.background": "#111418",
    "statusBar.foreground": "#B7C1CB",
    "statusBar.border": "#1F252C",
    "statusBar.noFolderBackground": "#111418",
    "statusBar.debuggingBackground": "#F2A33A",
    "statusBar.debuggingForeground": "#1A1206",
    "statusBarItem.remoteBackground": "#2BB3A3",
    "statusBarItem.remoteForeground": "#0B1418",
    "statusBarItem.hoverBackground": "#232932",
    "statusBarItem.prominentBackground": "#2BB3A333",

    "notifications.background": "#1B2027",
    "notifications.border": "#2A313A",
    "notificationsWarningIcon.foreground": "#E5C454",
    "notificationsErrorIcon.foreground": "#F47C6B",
    "notificationsInfoIcon.foreground": "#4FD1C1",
    "quickInput.background": "#1B2027",
    "quickInputList.focusBackground": "#2BB3A333",
    "menu.background": "#1B2027",
    "menu.selectionBackground": "#2BB3A333",
    "menu.border": "#2A313A",
    "pickerGroup.foreground": "#F2A33A",
    "keybindingLabel.foreground": "#E4E8EC",

    "gitDecoration.addedResourceForeground": "#86D99E",
    "gitDecoration.modifiedResourceForeground": "#F2C66D",
    "gitDecoration.deletedResourceForeground": "#F47C6B",
    "gitDecoration.untrackedResourceForeground": "#5BBF7A",
    "gitDecoration.ignoredResourceForeground": "#5F6873",
    "gitDecoration.conflictingResourceForeground": "#D38FC4",

    "charts.foreground": "#E4E8EC",
    "charts.red": "#F47C6B",
    "charts.blue": "#5CA8E0",
    "charts.yellow": "#F2C66D",
    "charts.orange": "#F2A33A",
    "charts.green": "#5BBF7A",
    "charts.purple": "#D38FC4",
    "testing.iconPassed": "#5BBF7A",
    "testing.iconFailed": "#F47C6B"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6B7580", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#F2A33A" }
    },
    {
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "#9FB0BF" }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#9BD68F" }
    },
    { "scope": ["string.regexp"], "settings": { "foreground": "#E6A0C4" } },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"],
      "settings": { "foreground": "#F28B6B" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#5CC8E0" }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": { "foreground": "#7DD3C0" }
    },
    {
      "scope": ["variable", "variable.other.readwrite", "meta.definition.variable"],
      "settings": { "foreground": "#E4E8EC" }
    },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#F2C66D" } },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property"
      ],
      "settings": { "foreground": "#B7C4D1" }
    },
    {
      "scope": ["variable.language"],
      "settings": { "foreground": "#F2A33A", "fontStyle": "italic" }
    },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#2BB3A3" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#F2C66D" } },
    { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#8A939D" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#2BB3A3", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw"], "settings": { "foreground": "#F2C66D" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#86D99E" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#F47C6B" } },
    { "scope": ["invalid"], "settings": { "foreground": "#F47C6B" } }
  ],
  "semanticTokenColors": {
    "parameter": "#F2C66D",
    "property": "#B7C4D1",
    "enumMember": "#F28B6B",
    "type": "#7DD3C0",
    "class": "#7DD3C0",
    "interface": "#7DD3C0",
    "function": "#5CC8E0",
    "method": "#5CC8E0",
    "namespace": "#7DD3C0"
  }
}
