    "statusBar.debuggingBackground": "#F2A33A",
    "statusBar.debuggingForeground": "#1A1206",
    "statusBarItem.remoteBackground": "#0E8074",
    "statusBarItem.remoteForeground": "#FFFFFF",
    "statusBarItem.hoverBackground": "#E1E6EA",
    "statusBarItem.prominentBackground": "#0E807433",
    "notifications.background": "#F0F3F5",
    "notifications.border": "#D5DBE0",
    "notificationsWarningIcon.foreground": "#806300",
    "notificationsErrorIcon.foreground": "#C2412D",
    "notificationsInfoIcon.foreground": "#0B6E64",
    "quickInput.background": "#F0F3F5",
    "quickInputList.focusBackground": "#0E807433",
    "menu.background": "#F0F3F5",
    "menu.selectionBackground": "#0E807433",
    "menu.border": "#D5DBE0",
    "pickerGroup.foreground": "#A35F00",
    "keybindingLabel.foreground": "#1B2530",
    "gitDecoration.addedResourceForeground": "#237A3F",
    "gitDecoration.modifiedResourceForeground": "#8A5A00",
    "gitDecoration.deletedResourceForeground": "#C2412D",
    "gitDecoration.untrackedResourceForeground": "#2E8B4A",
    "gitDecoration.ignoredResourceForeground": "#9AA3AC",
    "gitDecoration.conflictingResourceForeground": "#9C3F86",
    "charts.foreground": "#1B2530",
    "charts.red": "#C2412D",
    "charts.blue": "#1F6FB2",
    "charts.yellow": "#8A5A00",
    "charts.orange": "#A35F00",
    "charts.green": "#2E8B4A",
    "charts.purple": "#9C3F86",
    "testing.iconPassed": "#2E8B4A",
    "testing.iconFailed": "#C2412D"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#6E7883",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": {
        "foreground": "#A35F00"
      }
    },
    {
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"],
      "settings": {
        "foreground": "#4A5968"
      }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#3F7F3A"
      }
    },
    {
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#A33A77"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"],
      "settings": {
        "foreground": "#B8452A"
      }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#0B6E8A"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#13796B"
      }
    },
    {
      "scope": ["variable", "variable.other.readwrite", "meta.definition.variable"],
      "settings": {
        "foreground": "#1B2530"
      }
    },
    {
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#8A5A00"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#3B4B5C"
      }
    },
    {
      "scope": ["variable.language"],
      "settings": {
        "foreground": "#A35F00",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#0E8074"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#8A5A00"
      }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": {
        "foreground": "#5C6773"
      }
    },
    {
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "#0E8074",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.inline.raw"],
      "settings": {
        "foreground": "#8A5A00"
      }
    },
    {
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#237A3F"
      }
    },
    {
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#C2412D"
      }
    },
    {
      "scope": ["invalid"],
      "settings": {
        "foreground": "#C2412D"
      }
    }
  ],
  "semanticTokenColors": {
    "parameter": "#8A5A00",
    "property": "#3B4B5C",
    "enumMember": "#B8452A",
    "type": "#13796B",
    "class": "#13796B",
    "interface": "#13796B",
    "function": "#0B6E8A",
    "method": "#0B6E8A",
    "namespace": "#13796B"
  }
}
