    "list.highlightForeground": "#0B6E64",
    "list.warningForeground": "#806300",
    "list.errorForeground": "#C2412D",
    "tree.indentGuidesStroke": "#C5CCD3",
    "scrollbarSlider.background": "#5C677333",
