    "editorSuggestWidget.background": "#F0F3F5",
    "editorSuggestWidget.border": "#D5DBE0",
    "editorSuggestWidget.selectedBackground": "#0E807433",
    "editorSuggestWidget.highlightForeground": "#0B6E64",
    "diffEditor.insertedTextBackground": "#2E8B4A26",
    "diffEditor.removedTextBackground": "#C2412D26",
    "diffEditor.insertedLineBackground": "#2E8B4A14",
    "diffEditor.removedLineBackground": "#C2412D14",
    "editorGroup.border": "#DDE2E6",
    "editorGroupHeader.tabsBackground": "#E8ECEF",
    "editorGroupHeader.tabsBorder": "#DDE2E6",
