{
  "name": "mutt-ai",
  "displayName": "Mutt",
  "description": "Bring-your-own-model AI coding with visible routing and risk decisions (Jev).",
  "version": "0.0.1",
  "private": true,
  "publisher": "mutt-dev",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/SaketMunda/mutt.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:mutt.panel",
    "onView:mutt.decisions",
    "onCommand:mutt.focus",
    "onCommand:mutt.showLog",
    "onCommand:mutt.dev.showcase"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mutt",
          "title": "Mutt",
          "icon": "media/mutt.svg"
        }
      ]
    },
    "views": {
      "mutt": [
        {
          "type": "webview",
          "id": "mutt.panel",
          "name": "Mutt"
        },
        {
          "type": "webview",
          "id": "mutt.decisions",
          "name": "Decisions"
        }
      ]
    },
    "commands": [
      {
        "command": "mutt.focus",
        "title": "Focus Mutt",
        "category": "Mutt"
      },
      {
        "command": "mutt.showLog",
        "title": "Show Log",
        "category": "Mutt"
      },
      {
        "command": "mutt.dev.showcase",
        "title": "Toggle UI Kit Showcase (dev)",
        "category": "Mutt"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mutt.dev.showcase",
          "when": "mutt.devMode"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:webview": "vite build",
    "typecheck": "tsc -b tsconfig.json tsconfig.webview.json",
    "test": "vitest run",
    "test:integration": "node scripts/build.mjs && node test/integration/run.mjs",
    "screenshots": "node scripts/build.mjs && node scripts/screenshots.mjs",
    "package": "node scripts/build.mjs --production && vsce package --no-dependencies --skip-license --out dist-vsix/mutt-ai.vsix"
  },
  "dependencies": {
    "@vscode/codicons": "0.0.46-24",
    "preact": "^10.29.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "playwright-core": "1.63.0",
    "preact-render-to-string": "^6.7.0",
    "vite": "^8.3.1"
  }
}
