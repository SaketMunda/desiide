{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run desiide-ai extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/extensions/desiide-ai"],
      "outFiles": ["${workspaceFolder}/extensions/desiide-ai/dist/**/*.js"],
      "preLaunchTask": "desiide-ai: build"
    }
  ]
}
